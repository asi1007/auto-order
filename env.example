# Google Sheets API認証情報
# Google Cloud Consoleでサービスアカウントを作成し、JSONキーをダウンロードしてください
# https://console.cloud.google.com/apis/credentials
GOOGLE_CREDENTIALS_FILE=service_account.json

# 発注数シートのURL
SALES_SHEET_URL=https://docs.google.com/spreadsheets/d/1aAliE0u45YbMwcBMczrLrG82MRMjOVc999L3GWCUENE/edit?gid=1783029617#gid=1783029617

# 仕入情報シートのURL
PURCHASE_SHEET_URL=https://docs.google.com/spreadsheets/d/1aAliE0u45YbMwcBMczrLrG82MRMjOVc999L3GWCUENE/edit?gid=2001083245#gid=2001083245

# 仕入管理シートのURL（gid付き）
PURCHASE_MANAGEMENT_SHEET_URL=https://docs.google.com/spreadsheets/d/1Dvz3cS9DRGx4woEY0NNypgLPKxLZ55a4j8778YlCFls/edit?gid=1452652687#gid=1452652687
# 仕入管理のワークシート名（任意：指定があればgidより優先）
PURCHASE_MANAGEMENT_SHEET_NAME=仕入管理

# イーウーパスポートログイン情報
YIWUPASSPORT_EMAIL=atsushi.wada@shinshira-import.jp
YIWUPASSPORT_PASSWORD=Yamada0402

# ブラウザ設定（headless=Trueで非表示モード）
HEADLESS=True

# Chatwork設定（オプション）
# Chatwork APIトークンを設定すると、処理完了時に通知が送信されます
# https://www.chatwork.com/service/packages/chatwork/main/contents/api/token
CHATWORK_API_TOKEN=
CHATWORK_ROOM_ID=397092794

